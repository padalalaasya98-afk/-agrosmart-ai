# AgroSmart AI Environment Variables

# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database (PostgreSQL / Neon)
# If left unset or unreachable, the server automatically uses the high-performance embedded JSON repository
DATABASE_URL=postgresql://neondb_owner:password@ep-sample-123456.us-east-2.aws.neon.tech/agrosmart?sslmode=require

# Authentication (Optional JWT Secret for User Accounts)
JWT_SECRET=agrosmart_ai_secure_jwt_secret_hackathon_2025

# Optional External AI & Weather APIs (Deterministic fallbacks work out-of-the-box)
GEMINI_API_KEY=
OPENWEATHER_API_KEY=
